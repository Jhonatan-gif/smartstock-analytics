# Copiar como infra/.env (está en .gitignore) y completar.
# Tras cambiar un valor: docker compose up -d   (recrea Jenkins y reaplica JCasC)

# Jenkins (se crea este usuario; no hay asistente de instalación)
JENKINS_PORT=8081
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# GitHub: usuario y PAT fine-grained con acceso a smartstock-analytics y smartstock-shared-lib
#   Permisos: Contents (Read), Commit statuses (Read and write), Pull requests (Read), Metadata (Read)
GITHUB_USER=Jhonatan-gif
GITHUB_TOKEN=

# SonarQube: My Account -> Security -> Generate Token (tipo "Global Analysis Token" o "User Token")
SONAR_TOKEN=
