# ============================================================
# Configuración de entorno - StockDinamico Backend
# Renombra este archivo a .env y completa los valores
# NUNCA subas .env al repositorio (está en .gitignore)
# ============================================================

# Servidor
NODE_ENV=development
PORT=3001

# SQL Server - Ajusta según tu instancia
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=StockDinamico
DB_USER=sa
DB_PASSWORD=StockPass123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

# JWT
JWT_SECRET=1234567890qwerty
JWT_EXPIRES_IN=8h

# CORS - Origen del frontend
CORS_ORIGIN=http://localhost:5173
